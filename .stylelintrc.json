{
  "extends": [
    "stylelint-config-standard-scss",
    "stylelint-config-recess-order"
  ],
  "rules": {
    "property-no-vendor-prefix": [
      true,
      {
        "ignoreProperties": [
          "-moz-text-size-adjust",
          "-webkit-text-size-adjust"
        ]
      }
    ],
    "value-keyword-case": [
      "lower",
      {
        "ignoreKeywords": ["currentColor"]
      }
    ]
  }
}
